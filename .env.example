# 내 컴퓨터 미리 보기용: 이 파일을 .env 로 복사해서 쓰세요. .env 는 절대 공유하거나 올리지 마세요.
# 배포할 때는 Vercel 프로젝트 Settings → Environment Variables 에 같은 이름으로 넣습니다.

# [필수] 선생님의 Gemini API 키 (Google AI Studio)
GEMINI_API_KEY=

# [필수, 자동] 학생별 기록 저장소: Vercel → Storage(Marketplace) → "Upstash for Redis" 연결 시 자동으로 들어옵니다.
# (직접 넣을 때는 UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN 이름도 됩니다)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# [선택] 사용 모델
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite

# [선택] 사용량 제한 (AI 질문 + 사진 읽기 합계)
# 기기당 하루 / 같은 인터넷 주소당 하루(학교 와이파이에서 다 같이 쓰면 늘려 주세요) / 기기당 1분
DAILY_LIMIT=60
IP_DAILY_LIMIT=150
PER_MINUTE_LIMIT=6

# [선택] 기록 보관: 이 날수 동안 접속이 없으면 그 학생 기록을 자동 삭제
DATA_KEEP_DAYS=400

# [선택] 비밀번호: 비워 두면 주소만 알면 누구나 사용. 주소가 외부에 퍼졌을 때 잠그는 용도
CLASS_CODE=

# [테스트용] 1로 두면 Gemini 대신 가짜 답 / 메모리 저장소 사용
MOCK_GEMINI=
DEV_MEMORY_STORE=
